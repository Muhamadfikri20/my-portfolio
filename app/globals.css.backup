@tailwind base;
@tailwind components;
@tailwind utilities;

/* CSS Custom Properties for Theme System */
:root {
    --color-primary: #3b82f6;
    --color-secondary: #6366f1;
    --color-accent: #8b5cf6;
    --color-background: #ffffff;
    --color-surface: #f8fafc;
    --color-text: #1e293b;
    --color-text-secondary: #64748b;
    --color-border: #e2e8f0;
    --color-success: #10b981;
    --color-warning: #f59e0b;
    --color-error: #ef4444;
}

/* Theme-aware utility classes */
.theme-primary {
    color: var(--color-primary);
}

.theme-primary-bg {
    background-color: var(--color-primary);
}

.theme-secondary {
    color: var(--color-secondary);
}

.theme-secondary-bg {
    background-color: var(--color-secondary);
}

.theme-accent {
    color: var(--color-accent);
}

.theme-accent-bg {
    background-color: var(--color-accent);
}

.theme-background {
    background-color: var(--color-background);
}

.theme-surface {
    background-color: var(--color-surface);
}

.theme-text {
    color: var(--color-text);
}

.theme-text-secondary {
    color: var(--color-text-secondary);
}

.theme-border {
    border-color: var(--color-border);
}

/* Enhanced card styles with theme support */
.card {
    @apply bg-white dark: bg-neutral-800 rounded-lg border border-neutral-200 dark:border-neutral-700 p-6 shadow-sm transition-all duration-300;
    background-color: var(--color-surface);
    border-color: var(--color-border);
    box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1), 0 1px 2px 0 rgba(0, 0, 0, 0.06);
}

.card:hover {
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
    transform: translateY(-1px);
}

/* Enhanced sidebar navigation */
.sidebar-nav-item {
    @apply flex items-center gap-3 p-3 rounded-lg text-left transition-all duration-200;
    color: var(--color-text-secondary);
}

.sidebar-nav-item:hover {
    background-color: var(--color-surface);
    color: var(--color-text);
}

.sidebar-nav-item.active {
    background-color: var(--color-primary);
    color: white;
}

.sidebar-nav-item.active:hover {
    background-color: var(--color-primary);
    color: white;
}

/* Theme-aware gradients */
.theme-gradient-primary {
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-secondary) 100%);
}

.theme-gradient-secondary {
    background: linear-gradient(135deg, var(--color-secondary) 0%, var(--color-accent) 100%);
}

/* Enhanced button styles */
.btn-primary {
    @apply px-4 py-2 rounded-md font-medium transition-all duration-200 focus: outline-none focus:ring-2 focus:ring-offset-2;
    background-color: var(--color-primary);
    color: white;
}

.btn-primary:hover {
    filter: brightness(110%);
    transform: translateY(-1px);
}

.btn-primary:focus {
    --tw-ring-color: var(--color-primary);
}

/* Theme-aware text styles */
.text-theme-primary {
    color: var(--color-primary);
}

.text-theme-secondary {
    color: var(--color-text-secondary);
}

/* Enhanced shadows with theme support */
.shadow-theme {
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
}

.shadow-theme-lg {
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
}

/* Enhanced readability and contrast */
.text-high-contrast {
    color: var(--color-text);
    font-weight: 500;
}

.text-medium-contrast {
    color: var(--color-text-secondary);
    font-weight: 400;
}

.bg-high-contrast {
    background-color: var(--color-background);
}

.bg-surface-contrast {
    background-color: var(--color-surface);
}

/* Ensure minimum contrast ratios */
.theme-text {
    color: var(--color-text);
    font-weight: 500;
}

.theme-text-secondary {
    color: var(--color-text-secondary);
    font-weight: 400;
}

/* Enhanced card readability */
.card {
    @apply bg-white dark: bg-neutral-800 rounded-lg border border-neutral-200 dark:border-neutral-700 p-6 shadow-sm transition-all duration-300;
    background-color: var(--color-surface);
    border-color: var(--color-border);
    box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1), 0 1px 2px 0 rgba(0, 0, 0, 0.06);
    color: var(--color-text);
}

.card h1,
.card h2,
.card h3,
.card h4,
.card h5,
.card h6 {
    color: var(--color-text);
    font-weight: 600;
}

.card p,
.card span,
.card div {
    color: var(--color-text-secondary);
}

/* Smooth transitions for theme changes */
* {
    transition: background-color 0.3s ease, border-color 0.3s ease, color 0.3s ease;
}

@layer base {
    html {
        scroll-behavior: smooth;
    }

    body {
        font-family: system-ui, -apple-system, sans-serif;
        font-weight: 400;
        line-height: 1.5;
        color: #34275e;
        background-color: #ffffff;
        transition: background-color 0.3s ease, color 0.3s ease;
    }

    /* Dark mode styles */
    .dark body {
        color: #e5e7eb;
        background-color: #111827;
    }
}

@layer components {
    .sidebar-nav-item {
        @apply flex items-center gap-3 px-3 py-2 rounded-md text-sm font-medium text-neutral-700 hover: bg-neutral-100 hover:text-neutral-900 transition-colors duration-200;
        @apply dark: text-neutral-300 dark:hover:bg-neutral-800 dark:hover:text-neutral-100;
    }

    .sidebar-nav-item.active {
        @apply bg-primary-50 text-primary-600 hover: bg-primary-50 hover:text-primary-600;
        @apply dark: bg-primary-900 dark:bg-opacity-50 dark:text-primary-400 dark:hover:bg-primary-900 dark:hover:bg-opacity-50 dark:hover:text-primary-400;
    }

    .card {
        @apply bg-white border border-neutral-200 rounded-lg p-4 lg: p-6 shadow-sm hover:shadow-md transition-all duration-200;
        @apply dark: bg-neutral-800 dark:border-neutral-700 dark:hover:shadow-lg;
    }

    .skill-badge {
        @apply inline-flex items-center gap-2 px-2 py-1 bg-neutral-100 rounded text-xs font-medium text-neutral-700;
        @apply dark: bg-neutral-700 dark:text-neutral-300;
    }

    .stats-card {
        @apply flex items-center gap-3;
    }

    /* Mobile specific improvements */
    @media (max-width: 640px) {
        .card {
            @apply p-4;
        }

        .sidebar-nav-item {
            @apply px-4 py-3;
        }
    }
}

@layer utilities {
    .text-gradient {
        background: linear-gradient(135deg, #3b82f6, #1d4ed8);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }
}